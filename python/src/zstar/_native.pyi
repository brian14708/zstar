from collections.abc import Awaitable, Callable, Sequence
from os import PathLike
from types import TracebackType
from typing import TypeVar, Unpack

from typing_extensions import Buffer, Reader

from .types import (
    BinaryWriter,
    CborValue,
    EntryTuple,
    ErrorCategory,
    ManifestOptions,
    ObjectResolver,
    RangeSource,
    ReaderOptions,
    ReadReport,
    RequestProvider,
    SeekableReader,
    VerificationReport,
    WriterOptions,
)

_T = TypeVar("_T")

def _writer_call(operation: Callable[[], _T]) -> Awaitable[_T]: ...

class ZstarError(ValueError):
    category: ErrorCategory

class MemberCursor:
    @property
    def size(self) -> int: ...
    def tell(self) -> int: ...
    def seek(self, offset: int, whence: int) -> int: ...
    def advance(self, count: int) -> None: ...

class SyncArchive:
    @staticmethod
    def from_source(
        source: RangeSource, size: int, **options: Unpack[ReaderOptions]
    ) -> SyncArchive: ...
    @staticmethod
    def from_bytes(data: Buffer, **options: Unpack[ReaderOptions]) -> SyncArchive: ...
    @staticmethod
    def from_file(path: str, **options: Unpack[ReaderOptions]) -> SyncArchive: ...
    @staticmethod
    def from_fileobj(fileobj: SeekableReader, **options: Unpack[ReaderOptions]) -> SyncArchive: ...
    @staticmethod
    def from_url(
        url: str, *, headers: dict[str, str] | None = None, **options: Unpack[ReaderOptions]
    ) -> SyncArchive: ...
    @staticmethod
    def from_s3(
        bucket: str,
        key: str,
        *,
        endpoint: str | None = None,
        region: str | None = None,
        object_prefix: str | None = None,
        anon: bool | None = None,
        access_key_id: str | None = None,
        secret_access_key: str | None = None,
        session_token: str | None = None,
        **options: Unpack[ReaderOptions],
    ) -> SyncArchive: ...
    @property
    def closed(self) -> bool: ...
    @property
    def max_read_bytes(self) -> int: ...
    @property
    def root_extensions(self) -> dict[str, CborValue]: ...
    @property
    def entry_count(self) -> int: ...
    def entry(self, path: str) -> EntryTuple | None: ...
    def iter_entries(self, prefix: str | None = None) -> SyncEntries: ...
    def read(
        self,
        path: str,
        offset: int = 0,
        length: int | None = None,
        *,
        resolver: ObjectResolver | None = None,
    ) -> bytes: ...
    def read_link(self, path: str) -> str: ...
    def read_many(
        self, requests: Sequence[tuple[str, int, int]], *, resolver: ObjectResolver | None = None
    ) -> list[bytes]: ...
    def _open_member(self, path: str) -> MemberCursor: ...
    def _read_member(self, cursor: MemberCursor, size: int | None) -> bytes: ...
    def _read_member_into(self, cursor: MemberCursor, buffer: Buffer) -> int: ...
    def read_with_report(
        self, path: str, offset: int, length: int | None, *, resolver: ObjectResolver | None = None
    ) -> tuple[bytes, ReadReport]: ...
    def verify(self, *, external: bool = False) -> VerificationReport: ...
    def close(self) -> None: ...
    def __enter__(self) -> SyncArchive: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

class SyncEntries:
    def __iter__(self) -> SyncEntries: ...
    def __next__(self) -> EntryTuple: ...

class AsyncArchive:
    @staticmethod
    def from_bytes(data: Buffer, **options: Unpack[ReaderOptions]) -> Awaitable[AsyncArchive]: ...
    @staticmethod
    def from_source(
        source: RangeSource, size: int, **options: Unpack[ReaderOptions]
    ) -> Awaitable[AsyncArchive]: ...
    @staticmethod
    def from_file(path: str, **options: Unpack[ReaderOptions]) -> Awaitable[AsyncArchive]: ...
    @staticmethod
    def from_fileobj(
        fileobj: SeekableReader, **options: Unpack[ReaderOptions]
    ) -> Awaitable[AsyncArchive]: ...
    @staticmethod
    def from_url(
        url: str | None = None,
        *,
        headers: dict[str, str] | None = None,
        provider: RequestProvider | None = None,
        **options: Unpack[ReaderOptions],
    ) -> Awaitable[AsyncArchive]: ...
    @staticmethod
    def from_s3(
        bucket: str,
        key: str,
        *,
        endpoint: str | None = None,
        region: str | None = None,
        object_prefix: str | None = None,
        anon: bool | None = None,
        access_key_id: str | None = None,
        secret_access_key: str | None = None,
        session_token: str | None = None,
        **options: Unpack[ReaderOptions],
    ) -> Awaitable[AsyncArchive]: ...
    @property
    def closed(self) -> bool: ...
    @property
    def max_read_bytes(self) -> int: ...
    @property
    def root_extensions(self) -> dict[str, CborValue]: ...
    @property
    def entry_count(self) -> int: ...
    def entry(self, path: str) -> Awaitable[EntryTuple | None]: ...
    def read_link(self, path: str) -> Awaitable[str]: ...
    def iter_entries(self, prefix: str | None = None) -> AsyncEntries: ...
    def read(
        self,
        path: str,
        offset: int = 0,
        length: int | None = None,
        *,
        resolver: ObjectResolver | None = None,
    ) -> Awaitable[bytes]: ...
    def read_many(
        self, requests: Sequence[tuple[str, int, int]], *, resolver: ObjectResolver | None = None
    ) -> Awaitable[list[bytes]]: ...
    def _open_member(self, path: str) -> Awaitable[MemberCursor]: ...
    def _read_member(self, cursor: MemberCursor, size: int | None) -> Awaitable[bytes]: ...
    def _read_member_into(self, cursor: MemberCursor, buffer: Buffer) -> Awaitable[int]: ...
    def _read_member_into_at(
        self, cursor: MemberCursor, offset: int, buffer: Buffer
    ) -> Awaitable[int]: ...
    def read_with_report(
        self, path: str, offset: int, length: int | None, *, resolver: ObjectResolver | None = None
    ) -> Awaitable[tuple[bytes, ReadReport]]: ...
    def verify(self, *, external: bool = False) -> Awaitable[VerificationReport]: ...
    def close(self) -> Awaitable[None]: ...
    def __aenter__(self) -> Awaitable[AsyncArchive]: ...
    def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> Awaitable[None]: ...

class AsyncEntries:
    def __aiter__(self) -> AsyncEntries: ...
    def __anext__(self) -> Awaitable[EntryTuple]: ...
    def _next_batch(self) -> Awaitable[list[EntryTuple]]: ...

class ManifestArchive:
    def __init__(
        self, source: RangeSource, size: int, **options: Unpack[ManifestOptions]
    ) -> None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def entry_count(self) -> int: ...
    @property
    def spilled(self) -> bool: ...
    def entry(self, path: str) -> EntryTuple | None: ...
    def entries(self) -> list[EntryTuple]: ...
    def iter_entries(self) -> ManifestEntries: ...
    def read(
        self,
        path: str,
        offset: int = 0,
        length: int | None = None,
        *,
        resolver: ObjectResolver | None = None,
        verify_external: bool = False,
    ) -> bytes: ...
    def validate(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> ManifestArchive: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

class ManifestEntries:
    def __iter__(self) -> ManifestEntries: ...
    def __next__(self) -> EntryTuple: ...

def member_name(path: str) -> str: ...

class StagedWriter:
    def __init__(
        self,
        writer: EntryArchiveWriter,
        spool: Callable[[], object],
        external: Callable[[str, bytes, int], int] | None = None,
        external_threshold: int = 16 << 20,
        compression_level: int = 3,
    ) -> None: ...
    def mkdir(self, path: str, parents: bool = True, exist_ok: bool = False) -> None: ...
    def open(self, path: str) -> StagedMember: ...
    def add_file(self, path: str, body: Reader[bytes], size: int) -> None: ...
    def snapshot(self) -> list[tuple[EntryTuple, int]]: ...
    def finish(self, abort: bool = False) -> tuple[bool, list[BaseException]]: ...

class StagedMember:
    @property
    def name(self) -> str: ...
    @property
    def closed(self) -> bool: ...
    def write(self, data: Buffer) -> int: ...
    def seek(self, offset: int, whence: int = 0) -> int: ...
    def tell(self) -> int: ...
    def flush(self) -> None: ...
    def close(self, abort: bool = False) -> None: ...

class EntryArchiveWriter:
    def __init__(self, output: BinaryWriter, **options: Unpack[WriterOptions]) -> None: ...
    @property
    def closed(self) -> bool: ...
    def add(self, entry: EntryTuple, body: Reader[bytes] | None = None, size: int = 0) -> None: ...
    def add_path(
        self,
        path: str | PathLike[str],
        archive_name: str,
        *,
        preserve_metadata: bool = False,
        recursive: bool = True,
    ) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> EntryArchiveWriter: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

def decode_manifest_block(raw: bytes) -> CborValue: ...
def encode_manifest_block(value: CborValue) -> bytes: ...
def decode_object(encoded: bytes, size: int) -> bytes: ...
def pack_file(path: str, data: bytes) -> bytes: ...
def pack_directory(path: str | PathLike[str], *, preserve_metadata: bool = False) -> bytes: ...
def extract(
    data: bytes,
    destination: str | PathLike[str],
    *,
    objects: str | PathLike[str] | None = None,
    allow_special_bits: bool = False,
    verify_external: bool = False,
) -> None: ...
def materialize(
    data: bytes, *, objects: str | PathLike[str] | None = None, verify_external: bool = False
) -> bytes: ...
def put_presigned(
    data: bytes,
    url: str | None = None,
    *,
    headers: dict[str, str] | None = None,
    provider: RequestProvider | None = None,
) -> Awaitable[None]: ...
def s3_archive_metadata(data: Buffer) -> dict[str, str]: ...
