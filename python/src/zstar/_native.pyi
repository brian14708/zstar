from collections.abc import Awaitable, Callable, Sequence
from types import TracebackType
from typing import Generic, Literal, TypeVar, overload

from typing_extensions import Buffer

from . import _options, _transport_options
from ._kind import EntryKind
from .types import AsyncRequestProvider, ErrorCategory, ExtensionValue

_T = TypeVar("_T")
_Item = TypeVar("_Item")

def _writer_call(operation: Callable[[], _T]) -> Awaitable[_T]: ...

class ZstarError(ValueError):
    """Archive or storage failure with a stable category for error handling."""

    category: ErrorCategory

class BlockingAdapter:
    def __init__(self, value: object) -> None: ...
    def size(self) -> Awaitable[int]: ...
    def read_at(self, offset: int, length: int, /) -> Awaitable[bytes]: ...
    def read(self, size: int, /) -> Awaitable[bytes]: ...
    def write(self, data: Buffer, /) -> Awaitable[int]: ...
    def flush(self) -> Awaitable[None]: ...
    def get_encoded(self, address: str, hint: int, max_bytes: int, /) -> Awaitable[bytes]: ...
    def put_encoded(self, address: str, encoded: bytes, raw_size: int, /) -> Awaitable[int]: ...

class Source:
    @staticmethod
    def memory(data: Buffer) -> Source: ...
    @property
    def closed(self) -> bool: ...
    def size(self) -> int: ...
    def read_at(self, offset: int, length: int) -> bytes: ...
    def close(self) -> None: ...
    def __enter__(self) -> Source: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

class AsyncSource:
    @staticmethod
    def memory(data: Buffer) -> Awaitable[AsyncSource]: ...
    @property
    def closed(self) -> bool: ...
    def size(self) -> Awaitable[int]: ...
    def read_at(self, offset: int, length: int) -> Awaitable[bytes]: ...
    def aclose(self) -> Awaitable[None]: ...
    def __aenter__(self) -> Awaitable[AsyncSource]: ...
    def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> Awaitable[None]: ...

class Sink:
    @property
    def closed(self) -> bool: ...
    def write(self, data: bytes) -> int: ...
    def flush(self) -> None: ...
    def close(self) -> None: ...
    def abort(self) -> None: ...
    def __enter__(self) -> Sink: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

class AsyncSink:
    @property
    def closed(self) -> bool: ...
    def write(self, data: bytes) -> Awaitable[int]: ...
    def flush(self) -> Awaitable[None]: ...
    def aclose(self) -> Awaitable[None]: ...
    def aabort(self) -> Awaitable[None]: ...
    def __aenter__(self) -> Awaitable[AsyncSink]: ...
    def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> Awaitable[None]: ...

def open_source(
    location: str,
    options: _transport_options.SourceOptions | None = None,
    *,
    local_path: bool = False,
) -> Source: ...
def aopen_source(
    location: str,
    options: _transport_options.AsyncSourceOptions | None = None,
    *,
    local_path: bool = False,
) -> Awaitable[AsyncSource]: ...
def open_sink(
    location: str,
    options: _transport_options.SinkOptions | None = None,
    *,
    local_path: bool = False,
    mode: Literal["w", "x"] = "w",
    atomic: bool = False,
) -> Sink: ...
def aopen_sink(
    location: str,
    options: _transport_options.SinkOptions | None = None,
    *,
    local_path: bool = False,
    mode: Literal["w", "x"] = "w",
    atomic: bool = False,
) -> Awaitable[AsyncSink]: ...

class WriterSession:
    def _check_access(self) -> None: ...
    @property
    def failed(self) -> bool: ...
    @staticmethod
    def to_sink(sink: object, options: WriterConfig, *, owned: bool = False) -> WriterSession: ...
    @staticmethod
    def ato_sink(
        sink: object, options: WriterConfig, *, owned: bool = False
    ) -> Awaitable[WriterSession]: ...
    @property
    def closed(self) -> bool: ...
    def append(self, header: Header, body: object | None = None) -> None: ...
    def aappend(self, header: Header, body: object | None = None) -> Awaitable[None]: ...
    def append_path(self, path: str, name: str, preserve: bool, recursive: bool) -> None: ...
    def aappend_path(
        self, path: str, name: str, preserve: bool, recursive: bool
    ) -> Awaitable[None]: ...
    def append_bytes(self, path: str | Header, data: Buffer) -> None: ...
    def aappend_bytes(self, path: str | Header, data: Buffer) -> Awaitable[None]: ...
    def ensure_directory(self, path: str) -> None: ...
    def aensure_directory(self, path: str) -> Awaitable[None]: ...
    def append_external(self, header: Header, chunks: object, store: object) -> None: ...
    def aappend_external_body(
        self, header: Header, body: object, store: object
    ) -> Awaitable[None]: ...
    def aappend_external(
        self, header: Header, chunks: object, store: object
    ) -> Awaitable[None]: ...
    def close(self) -> None: ...
    def aclose(self) -> Awaitable[None]: ...
    def abort(self) -> None: ...
    def aabort(self) -> Awaitable[None]: ...

class ReaderConfig:
    def __init__(
        self, options: _options.ReaderOptions | _options.AsyncReaderOptions | None
    ) -> None: ...
    def with_resolver(self, resolver: object | None) -> ReaderConfig: ...

class WriterConfig:
    def __init__(self, options: _options.WriterOptions | None) -> None: ...

class Extent:
    @property
    def size(self) -> int: ...
    @property
    def source(self) -> int | str: ...
    @property
    def encoded_size(self) -> int: ...
    @property
    def offset(self) -> int: ...

class Extents:
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> Extent: ...
    @overload
    def __getitem__(self, index: slice) -> tuple[Extent, ...]: ...

class Header:
    @staticmethod
    def file(
        path: str,
        size: int,
        *,
        mode: int = 0o644,
        uid: int = 0,
        gid: int = 0,
        mtime_ns: int = 0,
        extensions: dict[str, ExtensionValue] | None = None,
    ) -> Header: ...
    @staticmethod
    def directory(
        path: str,
        *,
        mode: int = 0o755,
        uid: int = 0,
        gid: int = 0,
        mtime_ns: int = 0,
        extensions: dict[str, ExtensionValue] | None = None,
    ) -> Header: ...
    @staticmethod
    def symlink(
        path: str,
        target: str,
        *,
        mode: int = 0o777,
        uid: int = 0,
        gid: int = 0,
        mtime_ns: int = 0,
        extensions: dict[str, ExtensionValue] | None = None,
    ) -> Header: ...
    @property
    def path(self) -> str: ...
    @property
    def kind(self) -> EntryKind: ...
    @property
    def size(self) -> int: ...
    @property
    def mode(self) -> int: ...
    @property
    def uid(self) -> int: ...
    @property
    def gid(self) -> int: ...
    @property
    def mtime_ns(self) -> int: ...
    @property
    def linkname(self) -> str | None: ...
    @property
    def extensions(self) -> dict[str, ExtensionValue]: ...

class Entry:
    @property
    def path(self) -> str: ...
    @property
    def kind(self) -> EntryKind: ...
    @property
    def size(self) -> int: ...
    @property
    def mode(self) -> int: ...
    @property
    def uid(self) -> int: ...
    @property
    def gid(self) -> int: ...
    @property
    def mtime_ns(self) -> int: ...
    @property
    def linkname(self) -> str | None: ...
    @property
    def extensions(self) -> dict[str, ExtensionValue]: ...
    @property
    def extents(self) -> Sequence[Extent]: ...
    @property
    def is_external(self) -> bool: ...
    def to_header(self) -> Header: ...

class MemberCursor:
    @property
    def size(self) -> int: ...
    def tell(self) -> int: ...
    def seek(self, offset: int, whence: int) -> int: ...
    def advance(self, count: int) -> None: ...

class SyncArchive:
    def _check_access(self) -> None: ...
    def _read_many_values(self, requests: Sequence[_options.ReadRequest]) -> list[bytes]: ...
    @staticmethod
    def _from_source(
        source: object, options: ReaderConfig, *, owned: bool = False
    ) -> SyncArchive: ...
    @property
    def closed(self) -> bool: ...
    @property
    def max_read_bytes(self) -> int: ...
    @property
    def root_extensions(self) -> dict[str, ExtensionValue]: ...
    def _entry_value(self, path: str) -> Entry | None: ...
    def _iter_values(self, prefix: str | None = None) -> SyncEntries[Entry]: ...
    def read(self, path: str, offset: int = 0, length: int | None = None) -> bytes: ...
    def _open_member(self, path: str) -> MemberCursor: ...
    def _read_member(self, cursor: MemberCursor, size: int | None) -> bytes: ...
    def _read_member_into(self, cursor: MemberCursor, buffer: Buffer) -> int: ...
    def close(self) -> None: ...

class SyncEntries(Generic[_Item]):
    def _next_batch(self) -> list[_Item]: ...

class AsyncArchive:
    def _check_access(self) -> None: ...
    def _read_many_values(
        self, requests: Sequence[_options.ReadRequest]
    ) -> Awaitable[list[bytes]]: ...
    @staticmethod
    def _from_source(
        source: object, options: ReaderConfig, *, owned: bool = False
    ) -> Awaitable[AsyncArchive]: ...
    @property
    def closed(self) -> bool: ...
    @property
    def max_read_bytes(self) -> int: ...
    @property
    def root_extensions(self) -> dict[str, ExtensionValue]: ...
    def _entry_value(self, path: str) -> Awaitable[Entry | None]: ...
    def _iter_values(self, prefix: str | None = None) -> AsyncEntries[Entry]: ...
    def read(self, path: str, offset: int = 0, length: int | None = None) -> Awaitable[bytes]: ...
    def _open_member(self, path: str) -> Awaitable[MemberCursor]: ...
    def _read_member(self, cursor: MemberCursor, size: int | None) -> Awaitable[bytes]: ...
    def _read_member_into(self, cursor: MemberCursor, buffer: Buffer) -> Awaitable[int]: ...
    def _read_member_into_at(
        self, cursor: MemberCursor, offset: int, buffer: Buffer
    ) -> Awaitable[int]: ...
    def close(self) -> Awaitable[None]: ...

class AsyncEntries(Generic[_Item]):
    def _next_batch(self) -> Awaitable[list[_Item]]: ...

def member_name(path: str) -> str: ...
def put_presigned(
    data: bytes,
    url: str | None = None,
    *,
    headers: dict[str, str] | None = None,
    provider: AsyncRequestProvider | None = None,
) -> Awaitable[None]: ...
